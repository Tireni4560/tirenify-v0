# ── App URL (single source for every absolute URL) ──────────────────────────
# Server-side APP_URL: canonical/og tags, email links in the subscription
# flow, and the legacy-host 301 redirect target. Defaults to
# https://check.tirenify.app when unset. The 301 from check.tirenify.app to
# APP_URL is only active when APP_URL points at a DIFFERENT host.
APP_URL=https://check.tirenify.app

# Client-side VITE_APP_URL (build-time): baked into canonical/og/sitemap meta.
# Must match APP_URL. Defaults to https://check.tirenify.app when unset.
VITE_APP_URL=https://check.tirenify.app

# ── Email subscription (OPTIONAL) ───────────────────────────────────────────
# The breach check needs NONE of these. If they are absent the server still
# starts and the breach check works; only the email-subscription flow is off.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# ── Breach data (OPTIONAL) ──────────────────────────────────────────────────
# XposedOrNot works on the free tier without a key. Set this only to raise the
# upstream rate limit. The breach check works without it.
EXPOSED_ORKNOT_API_KEY=

# URL used in confirmation/unsubscribe emails. Defaults to APP_URL when unset.
FRONTEND_URL=

